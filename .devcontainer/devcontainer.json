{
  "name": "Nim",
  "image": "nim-dev:2.4.0",
  "remoteUser": "vscode",
  // Breakpoints need ptrace. The default seccomp profile blocks it.
  "capAdd": ["SYS_PTRACE"],
  "securityOpt": ["seccomp=unconfined"],
  // gcr-ssh-agent listens here. Mount it directly so the container does not
  // depend on Cursor having SSH_AUTH_SOCK in its own environment.
  // Git name and email live in the host XDG config. Cursor does not copy that
  // file, and the image keeps ~/.gitconfig for safe.directory and insteadOf.
  // Mounting the directory lets commits use the host identity after a rebuild.
  "mounts": [
    "source=${localEnv:XDG_RUNTIME_DIR:/run/user/1000}/gcr/ssh,target=/ssh-agent,type=bind",
    "source=${localEnv:HOME}/.config/git,target=/home/vscode/.config/git,type=bind,readonly"
  ],
  "remoteEnv": {
    "SSH_AUTH_SOCK": "/ssh-agent"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "/home/vscode/.vscode-extensions/nimvscode-1.8.1.vsix",
        "vadimcn.vscode-lldb"
      ],
      "settings": {
        "nim.lsp.path": "/home/vscode/.nimble/bin/nimlangserver"
      }
    }
  }
}
