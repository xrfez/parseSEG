(.nif27)
; Reference vendor map used by tests/tvendormaps.nim. ACME is fictitious.
(vendormap "acme-extended" (version 1)
  (match (format segd) (rev 2.0 2.1) (manufacturer 13))
  (doc "ACME record info in the SEG-D extended header")
  (target (kind extendedHeader) (blockIndex 1) (name acmeRecordInfo)
    (field crewName (at 1) (len 16) (enc ascii) (trim right))
    (field status (at 17) (enc u8) (bits (0 clipped) (1 dead) (2 reversed)))
    (field unitSn (at 18) (len 4 n) (enc bcd))
    (field mode (at 20) (enc u8) (enum (0 "normal") (1 "test") (2 "calibration")))
    (field tilt (at 21) (enc i16) (scale 0.01) (unit "deg"))
    (field depth (at 23) (enc u24) (sentinel 0xFFFFFF) (unit "cm"))
    (field nChannels (at 26) (enc u8))
    (field battery (at 27) (enc u16) (byteOrder little) (scale 0.001) (offset 10) (unit "V"))
    (field tail (at 29) (len 4) (enc raw)))
  (target (kind extendedHeader) (blockIndex 2) (name acmeChannels)
    (repeat (count 4) (stride 8) (at 1)
      (field chanId (at 1) (enc u32))
      (field gain (at 5) (enc f32))))
  (target (kind traceExt) (extension 2) (name acmeTraceStatus)
    (field position (at 1) (enc fixedpt) (unit "m"))
    (field level (at 6) (enc ibm32))
    (field label (at 10) (len 4) (enc ebcdic))
    (field code (at 14) (nibble low) (len 3 n) (enc bcd))
    (field kind (at 16) (enc u8) (enum (0xB0 "status") (0xB1 "gps")))))
