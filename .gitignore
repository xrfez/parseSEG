# The SEG standards and the sample data files stay local: they are not
# redistributable (tests that need the samples skip without them).
/SEG Spec/
# Atlas: dependency checkouts are reproducible from atlas.lock
deps/*
!deps/atlas.config

# The data set of `nim bench` (bench/specs.nim), unless PARSESEG_BENCH_DIR is set.
/bench/data/

# Local development environment and agent workflow files (not published)
/.agents/
/.claude/
/.devcontainer/
/.mcp/
/.vscode/
/PLAN.md
/AGENTS.md
