; GPS minus UTC leap seconds. Dates from the IERS Bulletin C list,
; through the leap of 2016-12-31. GPS minus UTC is (TAI minus UTC) minus 19;
; from 1972-01-01 until the first of these leaps the offset is -9.
; checkedTo is the last UTC date this list is known to be complete.
(leapSeconds
  (version 1)
  (checkedTo 2016 12 31)
  (leap (date 1972 1 1) (gpsMinusUtc -9))
  (leap (date 1972 7 1) (gpsMinusUtc -8))
  (leap (date 1973 1 1) (gpsMinusUtc -7))
  (leap (date 1974 1 1) (gpsMinusUtc -6))
  (leap (date 1975 1 1) (gpsMinusUtc -5))
  (leap (date 1976 1 1) (gpsMinusUtc -4))
  (leap (date 1977 1 1) (gpsMinusUtc -3))
  (leap (date 1978 1 1) (gpsMinusUtc -2))
  (leap (date 1979 1 1) (gpsMinusUtc -1))
  (leap (date 1980 1 1) (gpsMinusUtc 0))
  (leap (date 1981 7 1) (gpsMinusUtc 1))
  (leap (date 1982 7 1) (gpsMinusUtc 2))
  (leap (date 1983 7 1) (gpsMinusUtc 3))
  (leap (date 1985 7 1) (gpsMinusUtc 4))
  (leap (date 1988 1 1) (gpsMinusUtc 5))
  (leap (date 1990 1 1) (gpsMinusUtc 6))
  (leap (date 1991 1 1) (gpsMinusUtc 7))
  (leap (date 1992 7 1) (gpsMinusUtc 8))
  (leap (date 1993 7 1) (gpsMinusUtc 9))
  (leap (date 1994 7 1) (gpsMinusUtc 10))
  (leap (date 1996 1 1) (gpsMinusUtc 11))
  (leap (date 1997 7 1) (gpsMinusUtc 12))
  (leap (date 1999 1 1) (gpsMinusUtc 13))
  (leap (date 2006 1 1) (gpsMinusUtc 14))
